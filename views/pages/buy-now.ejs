    <!-- Server-Session Cart Script with Responsive Stepper Controls -->
    <script>
        (function () {
            localStorage.removeItem('roinax_cart');

            async function fetchServerCartCount() {
                try {
                    const res = await fetch('/api/cart');
                    const data = await res.json();
                    if (data.success && Array.isArray(data.items)) {
                        const totalCount = data.items.reduce((sum, item) => sum + (parseInt(item.quantity, 10) || 0), 0);
                        updateBadges(totalCount);
                    }
                } catch (err) {
                    console.warn('Could not fetch cart status:', err);
                }
            }

            function updateBadges(count) {
                document.querySelectorAll('.cart-count').forEach(el => el.textContent = count);

                const pill = document.getElementById('floatingCartPill');
                if (pill) {
                    const countEl = pill.querySelector('.cart-pill-count');
                    if (countEl) countEl.textContent = count;
                    pill.style.display = count > 0 ? 'inline-flex' : 'none';
                }
            }

            // Stepper functionality
            document.querySelectorAll('.qty-stepper').forEach(stepper => {
                const minusBtn = stepper.querySelector('.step-btn.minus');
                const plusBtn = stepper.querySelector('.step-btn.plus');
                const input = stepper.querySelector('.qty-input');

                minusBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    let current = parseInt(input.value, 10) || 1;
                    if (current > 1) {
                        input.value = current - 1;
                    }
                });

                plusBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    let current = parseInt(input.value, 10) || 1;
                    if (current < 100) {
                        input.value = current + 1;
                    }
                });
            });

            // Category Tabs Filtering
            const tabButtons = document.querySelectorAll('#categoryTabs .tab-btn');
            const productCards = document.querySelectorAll('.product-card');

            tabButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    tabButtons.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');

                    const filter = btn.getAttribute('data-filter');
                    productCards.forEach(card => {
                        if (filter === 'all' || card.getAttribute('data-category') === filter) {
                            card.style.display = 'flex';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });

            // Add to Cart via Direct Server Endpoint
            document.querySelectorAll('.add-to-cart-btn').forEach(button => {
                button.addEventListener('click', async function () {
                    const card = this.closest('.product-card');
                    const deviceId = card.getAttribute('data-id');
                    const name = card.getAttribute('data-name');
                    const price = parseInt(card.getAttribute('data-price'), 10);
                    const qtyInput = card.querySelector('.qty-input');
                    const quantity = Math.max(1, parseInt(qtyInput ? qtyInput.value : 1, 10) || 1);

                    this.disabled = true;
                    const originalContent = this.innerHTML;
                    this.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Adding...</span>';

                    try {
                        const res = await fetch('/api/cart/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ deviceId, name, price, quantity })
                        });
                        const data = await res.json();

                        if (res.ok && data.success) {
                            await fetchServerCartCount();
                            this.innerHTML = '<i class="fa-solid fa-check"></i> <span>Added</span>';
                            this.classList.add('btn-added');
                            setTimeout(() => {
                                this.innerHTML = originalContent;
                                this.classList.remove('btn-added');
                                this.disabled = false;
                            }, 1300);
                        } else {
                            alert(data.message || 'Could not add to Cart.');
                            this.innerHTML = originalContent;
                            this.disabled = false;
                        }
                    } catch (err) {
                        alert('Network error connecting to store server.');
                        this.innerHTML = originalContent;
                        this.disabled = false;
                    }
                });
            });

            document.addEventListener('DOMContentLoaded', fetchServerCartCount);
            fetchServerCartCount();
        })();
    </script>