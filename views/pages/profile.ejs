<section class="profile-section" style="padding: 120px 16px 60px;">
  <div class="container" style="max-width: 680px; margin: 0 auto;">
    <div class="auth-card">
      
      <!-- Top Action Bar -->
      <div class="brand-header">
        <div class="brand-title-wrap">
          <h2>My Profile</h2>
          <span class="auth-tag">VERIFIED</span>
        </div>
        <div class="header-actions-group">
          <a href="/cart" class="btn-profile-cart">
            <i class="fa-solid fa-bag-shopping"></i> Cart
            <% if (locals.cartCount && cartCount > 0) { %>
              <span class="cart-pill-count"><%= cartCount %></span>
            <% } %>
          </a>
        </div>
      </div>

      <!-- Flash Notifications -->
      <% if (locals.success_msg && success_msg.length > 0) { %>
        <div class="error-banner success">
          <i class="fa-solid fa-circle-check"></i> <%= success_msg %>
        </div>
      <% } %>
      <% if (locals.error_msg && error_msg.length > 0) { %>
        <div class="error-banner error">
          <i class="fa-solid fa-triangle-exclamation"></i> <%= error_msg %>
        </div>
      <% } %>

      <!-- Interactive Avatar Upload Section -->
      <div class="profile-avatar-wrap">
        <div class="avatar-preview-box" id="avatarPreviewContainer">
          <img 
            id="avatarPreviewImg"
            src="<%= user.avatarUrl || 'https://api.dicebear.com/7.x/initials/svg?seed=' + encodeURIComponent(user.firstName || user.email) %>" 
            alt="Profile Avatar" 
          />
          <label for="avatarFileInput" class="avatar-hover-overlay" title="Upload new photo">
            <i class="fa-solid fa-camera"></i>
          </label>
        </div>
        
        <div class="avatar-meta">
          <div style="display: flex; align-items: center; gap: 10px;">
            <label for="avatarFileInput" class="btn-upload-avatar">
              <i class="fa-solid fa-cloud-arrow-up"></i> Change Photo
            </label>
            <span id="avatarUploadSpinner" style="display: none; color: var(--green-lime); font-size: 0.85rem;">
              <i class="fa-solid fa-spinner fa-spin"></i> Uploading...
            </span>
          </div>
          <span class="avatar-tip">JPG, PNG, or WEBP (Max 2MB). Auto-crops to 1:1.</span>
        </div>
      </div>

      <!-- Hidden Form for Image Upload -->
      <form id="avatarUploadForm" action="/profile/avatar" method="POST" enctype="multipart/form-data" style="display: none;">
        <input 
          type="file" 
          id="avatarFileInput" 
          name="avatar" 
          accept="image/png, image/jpeg, image/jpg, image/webp" 
        />
      </form>

      <!-- SECTION 1: Personal Details Form -->
      <form action="/profile/update" method="POST">
        <div class="section-title-wrap">
          <h3>Personal Information</h3>
          <p class="section-sub-text">Update your identity and delivery preferences</p>
        </div>

        <div class="form-grid-2">
          <!-- First Name -->
          <div class="form-group">
            <label for="firstName">First Name</label>
            <div class="input-wrap">
              <i class="fa-solid fa-user input-icon"></i>
              <input 
                type="text" 
                id="firstName" 
                name="firstName" 
                value="<%= user.firstName || '' %>" 
                placeholder="First name"
                required 
              />
            </div>
          </div>

          <!-- Last Name -->
          <div class="form-group">
            <label for="lastName">Last Name</label>
            <div class="input-wrap">
              <i class="fa-solid fa-user input-icon"></i>
              <input 
                type="text" 
                id="lastName" 
                name="lastName" 
                value="<%= user.lastName || '' %>" 
                placeholder="Last name"
                required 
              />
            </div>
          </div>
        </div>

        <!-- Email Address (Uneditable / Readonly) -->
        <div class="form-group">
          <label for="profileEmail">
            Email Address <span class="badge-locked"><i class="fa-solid fa-lock"></i> Permanent</span>
          </label>
          <div class="input-wrap input-readonly-wrap">
            <i class="fa-solid fa-envelope input-icon"></i>
            <input 
              type="email" 
              id="profileEmail" 
              value="<%= user.email %>" 
              readonly 
              tabindex="-1"
              class="input-disabled"
            />
            <span class="input-lock-tag"><i class="fa-solid fa-shield-halved"></i> Verified</span>
          </div>
          <span class="input-hint">Your primary email is linked to account authentication and cannot be edited directly.</span>
        </div>

        <div class="form-grid-2">
          <!-- Date of Birth -->
          <div class="form-group">
            <label for="dob">Date of Birth</label>
            <div class="input-wrap">
              <i class="fa-solid fa-calendar-days input-icon"></i>
              <input 
                type="date" 
                id="dob" 
                name="dob" 
                value="<%= user.dob ? new Date(user.dob).toISOString().split('T')[0] : '' %>" 
              />
            </div>
          </div>

          <!-- Gender -->
          <div class="form-group">
            <label for="gender">Gender</label>
            <div class="input-wrap">
              <i class="fa-solid fa-venus-mars input-icon"></i>
              <select id="gender" name="gender" class="custom-select-input">
                <option value="" disabled <%= !user.gender ? 'selected' : '' %>>Select Gender</option>
                <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
                <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
                <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
                <option value="Prefer not to say" <%= user.gender === 'Prefer not to say' ? 'selected' : '' %>>Prefer not to say</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Mobile No -->
        <div class="form-group">
          <label for="phone">Mobile No.</label>
          <div class="input-wrap">
            <i class="fa-solid fa-phone input-icon"></i>
            <input 
              type="tel" 
              id="phone" 
              name="phone" 
              pattern="[0-9]{10}" 
              maxlength="10" 
              value="<%= user.phone || '' %>" 
              placeholder="10-digit mobile number" 
            />
          </div>
          <span class="input-hint">Used for dispatch confirmations, order alerts, and hardware delivery.</span>
        </div>

        <button type="submit" class="btn-auth-submit">
          <i class="fa-solid fa-floppy-disk"></i> Save Personal Details
        </button>
      </form>

      <hr class="profile-section-divider" />

      <!-- SECTION 2: Session Security & Password Update -->
      <div class="section-title-wrap">
        <h3>Session Security</h3>
        <p class="section-sub-text">Current authorization credentials and active tokens</p>
      </div>

      <div class="security-status-card">
        <div class="session-indicator-dot"></div>
        <div class="security-status-info">
          <p class="security-session-label">Active Connection</p>
          <p class="security-session-meta">
            Logged in via: <strong><%= user.password ? 'Email & Password' : 'Google OAuth' %></strong>
          </p>
        </div>
      </div>

      <!-- Update Password Form -->
      <form action="/profile/update-password" method="POST" class="password-update-form">
        <h4 class="sub-form-heading"><i class="fa-solid fa-lock"></i> Update Password</h4>

        <% if (user.password) { %>
          <div class="form-group">
            <label for="currentPassword">Current Password</label>
            <div class="input-wrap">
              <i class="fa-solid fa-shield-halved input-icon"></i>
              <input 
                type="password" 
                id="currentPassword" 
                name="currentPassword" 
                placeholder="Enter current password" 
                required 
                autocomplete="current-password" 
              />
            </div>
          </div>
        <% } %>

        <div class="form-grid-2">
          <div class="form-group">
            <label for="newPassword">New Password</label>
            <div class="input-wrap">
              <i class="fa-solid fa-key input-icon"></i>
              <input 
                type="password" 
                id="newPassword" 
                name="newPassword" 
                placeholder="Minimum 8 characters" 
                minlength="8" 
                required 
                autocomplete="new-password" 
              />
            </div>
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm Password</label>
            <div class="input-wrap">
              <i class="fa-solid fa-check-double input-icon"></i>
              <input 
                type="password" 
                id="confirmPassword" 
                name="confirmPassword" 
                placeholder="Confirm new password" 
                minlength="8" 
                required 
                autocomplete="new-password" 
              />
            </div>
          </div>
        </div>

        <button type="submit" class="btn-auth-submit btn-secondary-submit">
          <i class="fa-solid fa-key"></i> Update Password
        </button>
      </form>

      <!-- Danger Zone -->
      <div class="profile-danger-zone">
        <div class="danger-info">
          <h4>Terminate Session</h4>
          <p>Sign out of your active browser session immediately.</p>
        </div>
        <form action="/api/auth/logout" method="POST" style="margin: 0;">
          <button type="submit" class="btn-danger-logout">
            <i class="fa-solid fa-power-off"></i> Sign Out
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const fileInput = document.getElementById('avatarFileInput');
    const form = document.getElementById('avatarUploadForm');
    const previewImg = document.getElementById('avatarPreviewImg');
    const spinner = document.getElementById('avatarUploadSpinner');

    if (fileInput && form) {
      fileInput.addEventListener('change', () => {
        const file = fileInput.files[0];
        if (!file) return;

        if (file.size > 2 * 1024 * 1024) {
          alert('Image size exceeds 2MB limit. Please select a smaller photo.');
          fileInput.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = (e) => {
          if (previewImg) previewImg.src = e.target.result;
        };
        reader.readAsDataURL(file);

        if (spinner) spinner.style.display = 'inline-block';
        form.submit();
      });
    }
  });
</script>