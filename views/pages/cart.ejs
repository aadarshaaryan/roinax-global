<main class="cart-page">
    <div class="container">
        <div class="cart-page-header">
            <h1><i class="fa-solid fa-cart-shopping"></i> Review Your <span class="text-lime">Procurement Basket</span></h1>
            <a href="/buy-now" class="btn btn-ghost"><i class="fa-solid fa-arrow-left"></i> Continue Shopping</a>
        </div>

        <div class="cart-layout-grid" id="cartLayoutGrid">
            <!-- Items List -->
            <div class="cart-table-card">
                <div class="cart-card-header">
                    <h2>Selected Devices & Hardware</h2>
                    <button type="button" id="clearCartBtn" class="btn-clear-link">Clear Basket</button>
                </div>
                <div class="cart-items-container" id="cartItemsContainer">
                    <!-- Populated dynamically via server -->
                </div>
            </div>

            <!-- Order Summary & Checkout -->
            <aside class="cart-checkout-card">
                <h2>Procurement Summary</h2>
                <div class="summary-line">
                    <span>Devices Subtotal</span>
                    <span id="summarySubtotal">₹0</span>
                </div>
                <div class="summary-line">
                    <span>GST (18% Statutory)</span>
                    <span id="summaryTax">₹0</span>
                </div>
                <div class="summary-line">
                    <span>Courier / Dispatch</span>
                    <span class="text-free">FREE</span>
                </div>
                <div class="summary-separator"></div>
                <div class="summary-line total-line">
                    <span>Total Amount</span>
                    <span id="summaryGrandTotal">₹0</span>
                </div>

                <div class="cart-cta-actions">
                    <button type="button" id="openPayQrBtn" class="btn btn-green btn-block">
                        <i class="fa-solid fa-qrcode"></i> Pay via UPI QR Code
                    </button>
                    <button type="button" id="whatsappInquiryBtn" class="btn btn-whatsapp-order btn-block">
                        <i class="fa-brands fa-whatsapp"></i> Order on WhatsApp
                    </button>
                </div>
                <small class="secure-badge"><i class="fa-solid fa-lock"></i> Direct Merchant UPI Verification</small>
            </aside>
        </div>

        <!-- Empty Cart Display -->
        <div class="empty-cart-state" id="emptyCartState" style="display: none;">
            <i class="fa-solid fa-box-open"></i>
            <h2>Your basket is empty</h2>
            <p>Browse our catalog of biometric devices, MicroATMs, and RD licenses to build an order.</p>
            <a href="/buy-now" class="btn btn-green">Browse Hardware Catalog</a>
        </div>
    </div>

    <!-- Modal 1: Auth Gate (Guest prompt) -->
    <div class="custom-modal" id="authGateModal">
        <div class="modal-backdrop"></div>
        <div class="modal-dialog">
            <button type="button" class="modal-close" data-close>&times;</button>
            <div class="modal-icon-header"><i class="fa-solid fa-user-lock"></i></div>
            <h3>Account Required to Complete Order</h3>
            <p>Please log in or register your enterprise profile before checking out with a payment QR code.</p>
            <div class="modal-auth-actions">
                <a href="/login" class="btn btn-outline-dark-sm btn-block">Sign In</a>
                <a href="/signup" class="btn btn-green btn-block">Create New Account</a>
            </div>
        </div>
    </div>

    <!-- Modal 2: Billing Information Form -->
    <div class="custom-modal" id="billingModal">
        <div class="modal-backdrop"></div>
        <div class="modal-dialog billing-dialog">
            <button type="button" class="modal-close" data-close>&times;</button>
            <div class="modal-icon-header"><i class="fa-solid fa-file-invoice-dollar"></i></div>
            <h3>Billing Information</h3>
            <p>Provide delivery and tax details. A formal invoice copy will be emailed upon confirmation.</p>

            <form id="billingForm">
                <div class="billing-form-grid">
                    <div class="form-group span-2">
                        <label for="billFullName">Full Name / Business Name *</label>
                        <input type="text" id="billFullName" name="fullName" required placeholder="e.g. John Doe / Radhe Electronics">
                    </div>

                    <div class="form-group">
                        <label for="billEmail">Email Address *</label>
                        <input type="email" id="billEmail" name="email" required placeholder="name@domain.com">
                    </div>

                    <div class="form-group">
                        <label for="billPhone">Mobile Number *</label>
                        <input type="tel" id="billPhone" name="phone" pattern="[0-9]{10}" maxlength="10" required placeholder="10-digit number">
                    </div>

                    <div class="form-group span-2">
                        <label for="billAddress">Street Delivery Address *</label>
                        <input type="text" id="billAddress" name="address" required placeholder="House/Shop No., Landmark, Area">
                    </div>

                    <div class="form-group">
                        <label for="billCity">City *</label>
                        <input type="text" id="billCity" name="city" required placeholder="City">
                    </div>

                    <div class="form-group">
                        <label for="billState">State *</label>
                        <input type="text" id="billState" name="state" required placeholder="State">
                    </div>

                    <div class="form-group">
                        <label for="billPincode">PIN Code *</label>
                        <input type="text" id="billPincode" name="pincode" pattern="[0-9]{6}" maxlength="6" required placeholder="6-digit PIN">
                    </div>

                    <div class="form-group">
                        <label for="billGstin">GSTIN (Optional)</label>
                        <input type="text" id="billGstin" name="gstin" placeholder="22AAAAA0000A1Z5">
                    </div>
                </div>

                <button type="submit" id="submitBillingBtn" class="btn btn-green btn-block" style="margin-top: 14px;">
                    <i class="fa-solid fa-arrow-right"></i> Proceed to UPI QR Payment
                </button>
            </form>
        </div>
    </div>

    <!-- Modal 3: Merchant UPI QR Code Checkout -->
    <div class="custom-modal" id="qrModal">
        <div class="modal-backdrop"></div>
        <div class="modal-dialog qr-dialog">
            <button type="button" class="modal-close" data-close>&times;</button>
            <div class="qr-header">
                <h3>Scan & Pay via UPI</h3>
                <p>Compatible with PhonePe, Paytm, Google Pay, BHIM & Samsung Wallet.</p>
            </div>

            <div class="qr-box">
                <div class="qr-img-wrapper" style="background: #ffffff; padding: 12px; border-radius: 12px; display: inline-block; margin-bottom: 12px;">
                    <img id="qrImage" src="/assets/images/qr.jpeg" alt="Samsung Wallet UPI QR Code" class="qr-image"
                        style="width: 230px; height: auto; display: block; margin: 0 auto;"
                        onerror="this.src='/assets/images/qr.jpg'">
                </div>
                <div class="qr-amount-pill">
                    Payable Amount: <strong id="qrTotalDisplay">₹0</strong>
                </div>
                <div class="upi-id-box" style="margin-top: 10px; line-height: 1.5;">
                    <div>Beneficiary: <strong>WASIM KARIM</strong></div>
                    <div>UPI ID: <strong style="color: #82d12b;">rxw@pingpay</strong></div>
                </div>
            </div>

            <div class="qr-steps">
                <ol>
                    <li>Open any UPI application (GPay, PhonePe, Paytm, Samsung Wallet) and scan the QR code.</li>
                    <li>Enter the exact amount shown above and complete the payment.</li>
                    <li>Your billing information has been registered. Notify our dispatch desk on WhatsApp with your payment UTR / screenshot.</li>
                </ol>
            </div>

            <button type="button" id="confirmPaidWhatsAppBtn" class="btn btn-whatsapp-order btn-block">
                <i class="fa-brands fa-whatsapp"></i> Confirm Payment on WhatsApp
            </button>
        </div>
    </div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', async () => {
        localStorage.removeItem('roinax_cart');

        let cartItems = [];
        let currentUser = null;
        let lastBillingData = null;

        const container = document.getElementById('cartItemsContainer');
        const layout = document.getElementById('cartLayoutGrid');
        const emptyState = document.getElementById('emptyCartState');

        function formatINR(val) {
            return '₹' + Number(val).toLocaleString('en-IN');
        }

        async function loadServerCart() {
            try {
                const authRes = await fetch('/api/auth/me');
                const authData = await authRes.json();
                if (authData.authenticated && authData.user) {
                    currentUser = authData.user;
                }

                const cartRes = await fetch('/api/cart');
                const cartData = await cartRes.json();

                if (cartRes.status === 401 || !cartData.success) {
                    cartItems = [];
                } else {
                    cartItems = cartData.items || [];
                }

                renderCart();
            } catch (err) {
                console.error('Failed to load cart from server:', err);
                cartItems = [];
                renderCart();
            }
        }

        function renderCart() {
            if (!cartItems || cartItems.length === 0) {
                layout.style.display = 'none';
                emptyState.style.display = 'block';
                return;
            }

            layout.style.display = 'grid';
            emptyState.style.display = 'none';

            let html = '';
            let subtotal = 0;

            cartItems.forEach(item => {
                const qty = item.quantity || 1;
                const price = Number(item.price) || 0;
                const rowTotal = price * qty;
                subtotal += rowTotal;

                html += `
                <div class="cart-row" data-id="${item.deviceId}">
                    <div class="row-info">
                        <h4>${item.name}</h4>
                        <span class="unit-price">${formatINR(price)} each</span>
                    </div>
                    <div class="row-controls">
                        <div class="qty-control">
                            <button type="button" class="qty-btn dec-btn" data-id="${item.deviceId}" data-qty="${qty}">-</button>
                            <span class="qty-display">${qty}</span>
                            <button type="button" class="qty-btn inc-btn" data-id="${item.deviceId}" data-qty="${qty}">+</button>
                        </div>
                        <div class="row-total">${formatINR(rowTotal)}</div>
                        <button type="button" class="remove-btn" data-id="${item.deviceId}"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </div>`;
            });

            container.innerHTML = html;

            const tax = Math.round(subtotal * 0.18);
            const grand = subtotal + tax;

            document.getElementById('summarySubtotal').textContent = formatINR(subtotal);
            document.getElementById('summaryTax').textContent = formatINR(tax);
            document.getElementById('summaryGrandTotal').textContent = formatINR(grand);
        }

        container.addEventListener('click', async (e) => {
            const dec = e.target.closest('.dec-btn');
            const inc = e.target.closest('.inc-btn');
            const rem = e.target.closest('.remove-btn');

            if (dec) {
                const deviceId = dec.dataset.id;
                const currentQty = parseInt(dec.dataset.qty, 10);
                await fetch('/api/cart/update-qty', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ deviceId, quantity: currentQty - 1 })
                });
                await loadServerCart();
            } else if (inc) {
                const deviceId = inc.dataset.id;
                const currentQty = parseInt(inc.dataset.qty, 10);
                await fetch('/api/cart/update-qty', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ deviceId, quantity: currentQty + 1 })
                });
                await loadServerCart();
            } else if (rem) {
                const deviceId = rem.dataset.id;
                await fetch(`/api/cart/item/${deviceId}`, { method: 'DELETE' });
                await loadServerCart();
            }
        });

        document.getElementById('clearCartBtn').addEventListener('click', async () => {
            if (confirm('Clear all devices from your basket?')) {
                await fetch('/api/cart/clear', { method: 'DELETE' });
                await loadServerCart();
            }
        });

        const authModal = document.getElementById('authGateModal');
        const billingModal = document.getElementById('billingModal');
        const qrModal = document.getElementById('qrModal');

        function openModal(m) {
            m.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        function closeModal(m) {
            m.classList.remove('active');
            document.body.style.overflow = '';
        }

        document.querySelectorAll('[data-close]').forEach(b => {
            b.addEventListener('click', () => closeModal(b.closest('.custom-modal')));
        });

        document.querySelectorAll('.modal-backdrop').forEach(bg => {
            bg.addEventListener('click', () => closeModal(bg.closest('.custom-modal')));
        });

        // 1. Click "Pay via UPI QR Code" -> Opens Billing Modal (or Auth Gate if guest)
        const payBtn = document.getElementById('openPayQrBtn');
        if (payBtn) {
            payBtn.addEventListener('click', () => {
                if (!cartItems || cartItems.length === 0) return;

                if (!currentUser) {
                    openModal(authModal);
                    return;
                }

                // Prefill user profile details if available
                if (currentUser) {
                    document.getElementById('billFullName').value = currentUser.name || (currentUser.firstName ? `${currentUser.firstName} ${currentUser.lastName || ''}`.trim() : '');
                    document.getElementById('billEmail').value = currentUser.email || '';
                    if (currentUser.phone) document.getElementById('billPhone').value = currentUser.phone;
                }

                openModal(billingModal);
            });
        }

        // 2. Submit Billing Info -> Sends email to Gmail and opens QR modal
        const billingForm = document.getElementById('billingForm');
        billingForm.addEventListener('submit', async (e) => {
            e.preventDefault();

            const submitBtn = document.getElementById('submitBillingBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting & Generating QR...';

            const formData = new FormData(billingForm);
            const billingData = Object.fromEntries(formData.entries());
            lastBillingData = billingData;

            try {
                const response = await fetch('/api/cart/submit-billing', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(billingData)
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    alert(result.message || 'Failed to submit billing information. Please retry.');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fa-solid fa-arrow-right"></i> Proceed to UPI QR Payment';
                    return;
                }

                // Calculate totals for QR
                const sub = cartItems.reduce((s, i) => s + (Number(i.price) * (i.quantity || 1)), 0);
                const total = sub + Math.round(sub * 0.18);

                document.getElementById('qrTotalDisplay').textContent = formatINR(total);
                document.getElementById('qrImage').src = '/assets/images/qr.jpeg';

                // Close Billing Modal & Open QR Modal
                closeModal(billingModal);
                openModal(qrModal);

            } catch (err) {
                console.error('Billing submit error:', err);
                alert('Network issue while submitting details. Please try again.');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fa-solid fa-arrow-right"></i> Proceed to UPI QR Payment';
            }
        });

        // 3. Confirm payment on WhatsApp
        function sendWhatsApp(prepaid = false) {
            let text = prepaid ? "*PAYMENT COMPLETED - HARDWARE ORDER*%0A%0A" : "*HARDWARE INQUIRY*%0A%0A";
            
            const customerName = lastBillingData?.fullName || currentUser?.name || 'Customer';
            const customerEmail = lastBillingData?.email || currentUser?.email || '';
            const customerPhone = lastBillingData?.phone || '';

            text += `*Customer:* ${customerName}%0A*Email:* ${customerEmail}%0A`;
            if (customerPhone) text += `*Mobile:* ${customerPhone}%0A`;
            if (lastBillingData?.address) {
                text += `*Delivery To:* ${lastBillingData.address}, ${lastBillingData.city}, ${lastBillingData.state} - ${lastBillingData.pincode}%0A`;
            }
            text += "%0A*Items:*%0A";

            let sub = 0;
            cartItems.forEach((item, i) => {
                const qty = item.quantity || 1;
                const t = Number(item.price) * qty;
                sub += t;
                text += `${i + 1}. ${item.name} (x${qty}) - ₹${t.toLocaleString('en-IN')}%0A`;
            });

            const grand = sub + Math.round(sub * 0.18);
            text += `%0A*Grand Total (incl 18% GST):* ₹${grand.toLocaleString('en-IN')}%0A`;
            if (prepaid) {
                text += "%0A*Payment Method:* UPI QR (WASIM KARIM / rxw@pingpay)%0A*Status:* Paid. Attaching transaction screenshot.";
            }

            window.open(`https://wa.me/917318692999?text=${text}`, '_blank');
        }

        document.getElementById('confirmPaidWhatsAppBtn').addEventListener('click', () => sendWhatsApp(true));
        document.getElementById('whatsappInquiryBtn').addEventListener('click', () => sendWhatsApp(false));

        loadServerCart();
    });
</script>