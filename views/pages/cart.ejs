<main class="cart-page">
    <div class="container">
        <div class="cart-page-header">
            <h1><i class="fa-solid fa-cart-shopping"></i> Review Your <span class="text-lime">Procurement Basket</span></h1>
            <a href="/buy-now" class="btn btn-ghost"><i class="fa-solid fa-arrow-left"></i> Continue Shopping</a>
        </div>

        <div class="cart-layout-grid" id="cartLayoutGrid">
            <!-- Items List -->
            <div class="cart-table-card">
                <div class="cart-card-header">
                    <h2>Selected Devices & Hardware</h2>
                    <button type="button" id="clearCartBtn" class="btn-clear-link">Clear Basket</button>
                </div>
                <div class="cart-items-container" id="cartItemsContainer">
                    <!-- Populated dynamically via server with non-intrusive loader -->
                </div>
            </div>

            <!-- Order Summary & Checkout -->
            <aside class="cart-checkout-card">
                <h2>Procurement Summary</h2>
                <div class="summary-line">
                    <span>Devices Subtotal</span>
                    <span id="summarySubtotal">₹0</span>
                </div>
                <div class="summary-line">
                    <span>GST (18% Statutory)</span>
                    <span id="summaryTax">₹0</span>
                </div>
                <div class="summary-line">
                    <span>Courier / Dispatch</span>
                    <span class="text-free">FREE</span>
                </div>
                <div class="summary-separator"></div>
                <div class="summary-line total-line">
                    <span>Total Amount</span>
                    <span id="summaryGrandTotal">₹0</span>
                </div>

                <div class="cart-cta-actions">
                    <button type="button" id="openAddressModalBtn" class="btn btn-green btn-block">
                        <i class="fa-solid fa-truck-fast"></i> Proceed to Buy (Enter Address)
                    </button>
                </div>
                <small class="secure-badge"><i class="fa-solid fa-shield-halved"></i> 256-Bit Encrypted Payment Processing</small>
            </aside>
        </div>

        <!-- Empty Cart Display -->
        <div class="empty-cart-state" id="emptyCartState" style="display: none;">
            <i class="fa-solid fa-box-open"></i>
            <h2>Your basket is empty</h2>
            <p>Browse our catalog of biometric devices, MicroATMs, and RD licenses to build an order.</p>
            <a href="/buy-now" class="btn btn-green">Browse Hardware Catalog</a>
        </div>
    </div>

    <!-- Modal 1: Auth Gate (Guest Prompt) -->
    <div class="custom-modal" id="authGateModal">
        <div class="modal-backdrop"></div>
        <div class="modal-dialog">
            <button type="button" class="modal-close" data-close>&times;</button>
            <div class="modal-icon-header"><i class="fa-solid fa-user-lock"></i></div>
            <h3>Account Required to Complete Order</h3>
            <p>Please log in or register before checking out with the payment gateway.</p>
            <div class="modal-auth-actions">
                <a href="/login" class="btn btn-outline-dark-sm btn-block">Sign In</a>
                <a href="/signup" class="btn btn-green btn-block">Create New Account</a>
            </div>
        </div>
    </div>

    <!-- Modal 2: Delivery Address Form Modal -->
    <div class="custom-modal" id="addressModal">
        <div class="modal-backdrop"></div>
        <div class="modal-dialog billing-dialog">
            <button type="button" class="modal-close" data-close>&times;</button>
            <div class="modal-icon-header"><i class="fa-solid fa-location-dot"></i></div>
            <h3>Delivery & Shipping Address</h3>
            <p>Enter the destination where your hardware should be dispatched.</p>

            <form id="shippingAddressForm">
                <div class="billing-form-grid">
                    <div class="form-group span-2">
                        <label for="shipFullName">Full Name / Enterprise Name *</label>
                        <input type="text" id="shipFullName" name="fullName" required placeholder="e.g. Radheshyam Kumar">
                    </div>

                    <div class="form-group">
                        <label for="shipEmail">Gmail / Email Address *</label>
                        <input type="email" id="shipEmail" name="email" required placeholder="your.name@gmail.com">
                    </div>

                    <div class="form-group">
                        <label for="shipPhone">Delivery Contact Phone *</label>
                        <input type="tel" id="shipPhone" name="phone" pattern="[0-9]{10}" maxlength="10" required placeholder="10-digit mobile number">
                    </div>

                    <div class="form-group span-2">
                        <label for="shipAddress">Complete Delivery Address *</label>
                        <input type="text" id="shipAddress" name="address" required placeholder="Shop/House No., Street, Landmark">
                    </div>

                    <div class="form-group">
                        <label for="shipCity">City *</label>
                        <input type="text" id="shipCity" name="city" required placeholder="City">
                    </div>

                    <div class="form-group">
                        <label for="shipState">State *</label>
                        <input type="text" id="shipState" name="state" required placeholder="State">
                    </div>

                    <div class="form-group">
                        <label for="shipPincode">PIN Code *</label>
                        <input type="text" id="shipPincode" name="pincode" pattern="[0-9]{6}" maxlength="6" required placeholder="6-digit PIN">
                    </div>

                    <div class="form-group">
                        <label for="shipGstin">GSTIN (Optional)</label>
                        <input type="text" id="shipGstin" name="gstin" placeholder="Optional GST number">
                    </div>
                </div>

                <button type="submit" id="submitAddressBtn" class="btn btn-green btn-block" style="margin-top: 16px;">
                    <i class="fa-solid fa-lock"></i> Proceed to Pay
                </button>
            </form>
        </div>
    </div>

    <!-- Modal 3: Payment Success Modal -->
    <div class="custom-modal" id="orderSuccessModal">
        <div class="modal-backdrop"></div>
        <div class="modal-dialog">
            <button type="button" class="modal-close" data-close>&times;</button>
            <div class="modal-icon-header" style="background: rgba(83, 169, 34, 0.2); color: #82d12b;">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <h3>Order & Payment Confirmed!</h3>
            <p>Your transaction has been verified. The itemized invoice and delivery details have been emailed to your Gmail account and our dispatch desk.</p>
            <a href="/buy-now" class="btn btn-green btn-block" style="margin-top: 15px;">Continue Shopping</a>
        </div>
    </div>
</main>

<!-- Load Razorpay Official SDK -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', async () => {
        let cartItems = [];
        let currentUser = null;

        const container = document.getElementById('cartItemsContainer');
        const layout = document.getElementById('cartLayoutGrid');
        const emptyState = document.getElementById('emptyCartState');

        function formatINR(val) {
            return '₹' + Number(val || 0).toLocaleString('en-IN');
        }

        // 1. Independent Auth Fetch
        try {
            const authRes = await fetch('/api/auth/me');
            if (authRes.ok) {
                const authData = await authRes.json();
                if (authData.success && authData.user) {
                    currentUser = authData.user;
                } else if (authData.authenticated && authData.user) {
                    currentUser = authData.user;
                }
            }
        } catch (e) {
            console.warn('[Cart Auth Check]: Guest mode or endpoint unreached', e);
        }

        // 2. Load Cart with Non-Blocking Inline Micro-Loader
        async function loadServerCart(showInitialSpinner = true) {
            if (showInitialSpinner && container) {
                container.innerHTML = `
                    <div class="cart-inline-loading">
                        <div class="brand-mini-loader">
                            <div class="mini-spin-ring"></div>
                            <img src="/assets/images/logo-icon.png" alt="Loading" class="mini-center-icon">
                        </div>
                        <span>Syncing your basket...</span>
                    </div>
                `;
            }

            try {
                const cartRes = await fetch('/api/cart');
                const cartData = await cartRes.json();

                if (cartData && cartData.success && Array.isArray(cartData.items)) {
                    cartItems = cartData.items;
                } else {
                    cartItems = [];
                }
            } catch (err) {
                console.error('Failed to load cart from server:', err);
                cartItems = [];
            }
            renderCart();
        }

        // 3. Render Cart Items
        function renderCart() {
            if (!container || !layout || !emptyState) return;

            if (!cartItems || cartItems.length === 0) {
                layout.style.display = 'none';
                emptyState.style.display = 'block';
                return;
            }

            layout.style.display = 'grid';
            emptyState.style.display = 'none';

            let html = '';
            let subtotal = 0;

            cartItems.forEach(item => {
                const qty = parseInt(item.quantity, 10) || 1;
                const price = Number(item.price) || 0;
                const rowTotal = price * qty;
                subtotal += rowTotal;

                html += `
                <div class="cart-row" data-id="${item.deviceId}">
                    <div class="row-info">
                        <h4>${item.name || 'Hardware Device'}</h4>
                        <span class="unit-price">${formatINR(price)} each</span>
                    </div>
                    <div class="row-controls">
                        <div class="qty-control">
                            <button type="button" class="qty-btn dec-btn" data-id="${item.deviceId}" data-qty="${qty}">-</button>
                            <span class="qty-display">${qty}</span>
                            <button type="button" class="qty-btn inc-btn" data-id="${item.deviceId}" data-qty="${qty}">+</button>
                        </div>
                        <div class="row-total">${formatINR(rowTotal)}</div>
                        <button type="button" class="remove-btn" data-id="${item.deviceId}" title="Remove item">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>`;
            });

            container.innerHTML = html;

            const tax = Math.round(subtotal * 0.18);
            const grand = subtotal + tax;

            const subEl = document.getElementById('summarySubtotal');
            const taxEl = document.getElementById('summaryTax');
            const grandEl = document.getElementById('summaryGrandTotal');

            if (subEl) subEl.textContent = formatINR(subtotal);
            if (taxEl) taxEl.textContent = formatINR(tax);
            if (grandEl) grandEl.textContent = formatINR(grand);
        }

        // 4. Subtle In-Place Quantity Updates & Item Removal
        container.addEventListener('click', async (e) => {
            const dec = e.target.closest('.dec-btn');
            const inc = e.target.closest('.inc-btn');
            const rem = e.target.closest('.remove-btn');

            if (dec || inc) {
                const btn = dec || inc;
                const deviceId = btn.dataset.id;
                const currentQty = parseInt(btn.dataset.qty, 10);
                const targetQty = dec ? currentQty - 1 : currentQty + 1;

                const row = btn.closest('.cart-row');
                const qtyDisplay = row ? row.querySelector('.qty-display') : null;

                // Subtle in-place spinner replaces only the quantity digit
                if (qtyDisplay) {
                    qtyDisplay.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin qty-spinner"></i>';
                }
                if (row) row.classList.add('row-updating');

                try {
                    await fetch('/api/cart/update-qty', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ deviceId, quantity: targetQty })
                    });
                    await loadServerCart(false); // Seamless update without full re-render jump
                } catch (err) {
                    console.error('Qty update error:', err);
                    await loadServerCart(false);
                }
            } else if (rem) {
                const deviceId = rem.dataset.id;
                const row = rem.closest('.cart-row');
                if (row) {
                    row.style.opacity = '0.35';
                    row.style.pointerEvents = 'none';
                }
                await fetch(`/api/cart/item/${deviceId}`, { method: 'DELETE' });
                await loadServerCart(false);
            }
        });

        // Clear Basket
        const clearBtn = document.getElementById('clearCartBtn');
        if (clearBtn) {
            clearBtn.addEventListener('click', async () => {
                if (confirm('Clear all devices from your basket?')) {
                    await fetch('/api/cart/clear', { method: 'DELETE' });
                    await loadServerCart(false);
                }
            });
        }

        // Modals
        const authModal = document.getElementById('authGateModal');
        const addressModal = document.getElementById('addressModal');
        const orderSuccessModal = document.getElementById('orderSuccessModal');

        function openModal(m) {
            if (!m) return;
            m.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        function closeModal(m) {
            if (!m) return;
            m.classList.remove('active');
            document.body.style.overflow = '';
        }

        document.querySelectorAll('[data-close]').forEach(b => {
            b.addEventListener('click', () => closeModal(b.closest('.custom-modal')));
        });

        document.querySelectorAll('.modal-backdrop').forEach(bg => {
            bg.addEventListener('click', () => closeModal(bg.closest('.custom-modal')));
        });

        // Step 1: Click "Proceed to Buy" -> Delivery Address Prompt
        const openAddressBtn = document.getElementById('openAddressModalBtn');
        if (openAddressBtn) {
            openAddressBtn.addEventListener('click', () => {
                if (!cartItems || cartItems.length === 0) return;

                if (!currentUser) {
                    openModal(authModal);
                    return;
                }

                if (currentUser) {
                    const fullName = (currentUser.firstName ? `${currentUser.firstName} ${currentUser.lastName || ''}` : currentUser.name) || '';
                    const fnInput = document.getElementById('shipFullName');
                    const emInput = document.getElementById('shipEmail');
                    const phInput = document.getElementById('shipPhone');

                    if (fnInput) fnInput.value = fullName.trim();
                    if (emInput) emInput.value = currentUser.email || '';
                    if (phInput && currentUser.phone) phInput.value = currentUser.phone;
                }

                openModal(addressModal);
            });
        }

        // Step 2: Submit Address -> Trigger Razorpay Gateway
        const shippingForm = document.getElementById('shippingAddressForm');
        if (shippingForm) {
            shippingForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                const submitBtn = document.getElementById('submitAddressBtn');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Initializing Payment Gateway...';

                const formData = new FormData(shippingForm);
                const shippingData = Object.fromEntries(formData.entries());

                try {
                    const orderRes = await fetch('/api/cart/create-order', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const orderData = await orderRes.json();

                    if (!orderRes.ok || !orderData.success) {
                        alert(orderData.message || 'Could not connect to payment gateway. Please retry.');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="fa-solid fa-lock"></i> Proceed to Pay';
                        return;
                    }

                    closeModal(addressModal);

                    const options = {
                        key: orderData.key,
                        amount: orderData.amount,
                        currency: orderData.currency,
                        name: 'ROINAX Global',
                        description: 'Enterprise Hardware Procurement',
                        image: '/assets/images/logo.png',
                        order_id: orderData.orderId,
                        prefill: {
                            name: shippingData.fullName,
                            email: shippingData.email,
                            contact: shippingData.phone
                        },
                        theme: {
                            color: '#53a922'
                        },
                        handler: async function (response) {
                            const verifyRes = await fetch('/api/cart/verify-payment', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_signature: response.razorpay_signature,
                                    shippingData: shippingData
                                })
                            });

                            const verifyData = await verifyRes.json();

                            if (verifyRes.ok && verifyData.success) {
                                openModal(orderSuccessModal);
                                await loadServerCart(false);
                            } else {
                                alert(verifyData.message || 'Verification issue. Please contact support.');
                            }
                        },
                        modal: {
                            ondismiss: function () {
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = '<i class="fa-solid fa-lock"></i> Proceed to Pay';
                            }
                        }
                    };

                    const rzp = new Razorpay(options);
                    rzp.open();

                } catch (err) {
                    console.error('Checkout error:', err);
                    alert('Connection failure while initiating checkout.');
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fa-solid fa-lock"></i> Proceed to Pay';
                }
            });
        }

        // Initial Server Cart Fetch
        await loadServerCart(true);
    });
</script>