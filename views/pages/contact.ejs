<main class="contact-page">
    <!-- Header Banner -->
    <section class="contact-hero">
        <div class="container text-center">
            <div class="eyebrow center dark">
                <span class="eyebrow-line"></span>
                <span class="eyebrow-green">Get In Touch</span>
                <span class="eyebrow-line"></span>
            </div>
            <h1>Let's Build Something <span class="text-lime">Remarkable</span></h1>
            <p class="contact-subtitle">
                Have questions about our multi-vertical business solutions? Our corporate team is here to assist you.
            </p>
        </div>
    </section>

    <!-- Main Content Grid -->
    <section class="contact-section">
        <div class="container contact-grid">
            <!-- Left Column: Official Contact & Socials -->
            <div class="contact-info-col reveal-left">
                <div class="info-card">
                    <h3>Contact Information</h3>
                    <p class="info-desc">Reach out directly via email, message our corporate team on WhatsApp, or follow
                        our global community.</p>

                    <div class="info-items">
                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fa-solid fa-envelope-open-text"></i>
                            </div>
                            <div class="info-content">
                                <span class="info-label">Corporate Email</span>
                                <a href="mailto:info@roinaxglobal.com" class="info-link">info@roinaxglobal.com</a>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fa-regular fa-envelope"></i>
                            </div>
                            <div class="info-content">
                                <span class="info-label">Direct Inquiries</span>
                                <a href="mailto:roinaxglobal@gmail.com" class="info-link">roinaxglobal@gmail.com</a>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <i class="fa-brands fa-whatsapp"></i>
                            </div>
                            <div class="info-content">
                                <span class="info-label">WhatsApp Consultation</span>
                                <a href="https://wa.me/917318692999?text=Hello%20ROINAX%20GLOBAL%2C%20I%20would%20like%20to%20discuss%20business%20solutions."
                                    target="_blank" rel="noopener noreferrer" class="info-link">+91 73186 92999</a>
                            </div>
                        </div>
                    </div>

                    <!-- Verified Social Media Links -->
                    <div class="social-connect">
                        <span class="social-label">Follow Our Official Channels</span>
                        <div class="social-links-grid">
                            <a href="https://www.facebook.com/share/1CcWXgykZu/" target="_blank"
                                rel="noopener noreferrer" class="social-badge fb" aria-label="Facebook">
                                <i class="fa-brands fa-facebook-f"></i>
                                <span>Facebook</span>
                            </a>
                            <a href="https://www.instagram.com/roinax_global?mdxt=a2dzamRxcjN3ajJh" target="_blank"
                                rel="noopener noreferrer" class="social-badge ig" aria-label="Instagram">
                                <i class="fa-brands fa-instagram"></i>
                                <span>Instagram</span>
                            </a>
                            <a href="https://youtube.com/@roinax_global?si=5GqXrmP3lqu_AqCs" target="_blank"
                                rel="noopener noreferrer" class="social-badge yt" aria-label="YouTube">
                                <i class="fa-brands fa-youtube"></i>
                                <span>YouTube</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Interactive Consultation Request Form -->
            <div class="contact-form-col reveal-right">
                <div class="form-wrapper">
                    <h3>Send Us a Message</h3>
                    <p class="form-desc">Fill out the form below and an industry specialist will contact you within 24
                        business hours.</p>

                    <div id="contact-status" class="contact-status-banner" style="display: none;"></div>

                    <form id="contactForm" novalidate>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="fullName">Full Name *</label>
                                <input type="text" id="fullName" name="fullName" placeholder="Your Name" required>
                            </div>
                            <div class="form-group">
                                <label for="contactEmail">Work Email *</label>
                                <input type="email" id="contactEmail" name="contactEmail" placeholder="name@company.com"
                                    required>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="phone">Phone / WhatsApp</label>
                                <input type="tel" id="phone" name="phone" placeholder="+91 XXXXX XXXXX">
                            </div>
                            <div class="form-group">
                                <label for="serviceInterest">Service (Optional)</label>
                                <select id="serviceInterest" name="serviceInterest">
                                    <option value="" disabled selected>Select a Service</option>
                                    <option value="Logo Design & Branding">Logo Design & Branding</option>
                                    <option value="Website Development & E-Commerce">Website Development & E-Commerce
                                    </option>
                                    <option value="Domain & Cloud Hosting">Domain & Cloud Hosting</option>
                                    <option value="Global Logistics & Courier">Global Logistics & Courier</option>
                                    <option value="Legal & Compliance">Legal & Compliance</option>
                                    <option value="Banking & Insurance Solutions">Banking & Insurance Solutions</option>
                                    <option value="Franchise Strategy & Consulting">Franchise Strategy & Consulting
                                    </option>
                                    <option value="Digital Marketing & Growth">Digital Marketing & Growth</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="message">Project Scope or Message *</label>
                            <textarea id="message" name="message" rows="4"
                                placeholder="Briefly describe your requirements or timeline..." required></textarea>
                        </div>

                        <button type="submit" id="submitContactBtn" class="btn btn-green btn-contact-submit">
                            <span>Send Inquiry</span>
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>
</main>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const contactForm = document.getElementById('contactForm');
        const submitBtn = document.getElementById('submitContactBtn');
        const statusBanner = document.getElementById('contact-status');

        if (!contactForm || !submitBtn || !statusBanner) return;

        function showStatus(message, isSuccess = true) {
            statusBanner.textContent = message;
            statusBanner.className = `contact-status-banner ${isSuccess ? 'success' : 'error'}`;
            statusBanner.style.display = 'block';
            statusBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        contactForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            statusBanner.style.display = 'none';

            const fullName = document.getElementById('fullName').value.trim();
            const contactEmail = document.getElementById('contactEmail').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const serviceSelect = document.getElementById('serviceInterest');
            const serviceInterest = serviceSelect ? serviceSelect.value : '';
            const message = document.getElementById('message').value.trim();

            if (!fullName || !contactEmail || !message) {
                showStatus('Please fill in your name, email, and message.', false);
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span>Sending...</span> <i class="fa-solid fa-spinner fa-spin"></i>';

            try {
                const res = await fetch('/api/contact/send', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        fullName,
                        contactEmail,
                        phone,
                        serviceInterest,
                        message
                    })
                });

                const data = await res.json();

                if (res.ok && data.success) {
                    showStatus(data.message, true);
                    contactForm.reset();
                } else {
                    showStatus(data.message || 'Failed to submit inquiry. Please try again.', false);
                }
            } catch (err) {
                console.error('Contact Form Fetch Error:', err);
                showStatus('Network error. You can also contact us directly via WhatsApp.', false);
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<span>Send Inquiry</span> <i class="fa-solid fa-paper-plane"></i>';
            }
        });
    });
</script>